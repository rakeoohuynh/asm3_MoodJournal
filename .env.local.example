APP_ENV=local
STORAGE_BACKEND=memory

# Local development only. Replace with another long random value if desired.
JWT_SECRET=local-development-secret-change-me-32-bytes-minimum
JWT_TTL_HOURS=24

# Optional. Leave blank to use the built-in offline mood/reflection fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
