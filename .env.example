# Copy to .env for local development. Never commit .env.

# AWS
AWS_REGION=us-east-1

# DynamoDB
DYNAMODB_TABLE_NAME=MoodJournalTable-dev
USERS_TABLE_NAME=MoodJournalUsers-dev

# S3 and Athena
ANALYTICS_BUCKET_NAME=
ATHENA_DATABASE=moodjournal_dev
ATHENA_WORKGROUP=moodjournal-dev
ATHENA_OUTPUT_LOCATION=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Session tokens. Use a long random string, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_HOURS=24

# Runtime
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGIN=http://localhost:5500
